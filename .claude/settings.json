{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test:smoke)",
      "Bash(node --check *)",
      "Bash(npx prettier@3 *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  }
}
